# Copy to .env to override. Every value has a local default matching infra/docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://pme:pme@localhost:5432/pme
# Outbox relay: on in every worker unless turned off; poll interval (ms) and rows per pass.
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=100
# Repeating cleanup and due-date reminder jobs (scheduled queue).
SCHEDULED_JOBS_ENABLED=true
# Email: smtp (Mailpit locally, inbox at http://localhost:8025) or resend (production).
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
EMAIL_FROM=Plan My Event <hello@planmyevent.local>
# Object storage: Cloudflare R2 in production (endpoint https://<account>.r2.cloudflarestorage.com,
# region auto); local defaults point at the compose SeaweedFS.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pme-local-access
S3_SECRET_ACCESS_KEY=pme-local-secret
S3_PUBLIC_BUCKET=pme-public
S3_PRIVATE_BUCKET=pme-private
