# Copy to .env.local to override. Defaults match the local API.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Show "Continue with Google" (set when the API has GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET).
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
# Cloudflare Turnstile site key for the public registration form (pairs with the API's
# TURNSTILE_SECRET_KEY). Empty: Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
