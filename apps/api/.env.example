# Copy to .env to override. Every value below has a local default that matches
# infra/docker-compose.yml, so .env is optional in development and required in production.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://pme:pme@localhost:5432/pme
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:3000
# This API's public URL (OAuth callbacks are built from it).
API_URL=http://localhost:4000
# At least 32 random characters in production, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Derives guests' invitation links; at least 32 random characters in production. Changing it
# breaks every link already shared.
INVITATION_LINK_KEY=
# Cloudflare Turnstile secret for the public registration form (dashboard → Turnstile → site).
# Left empty in development: Cloudflare's always-pass test secret is used.
TURNSTILE_SECRET_KEY=
# Object storage: Cloudflare R2 in production (endpoint https://<account>.r2.cloudflarestorage.com,
# region auto); local defaults point at the compose SeaweedFS.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=pme-local-access
S3_SECRET_ACCESS_KEY=pme-local-secret
S3_PUBLIC_BUCKET=pme-public
S3_PRIVATE_BUCKET=pme-private
# Public URL of the public bucket (the CDN domain in production).
MEDIA_PUBLIC_URL=http://localhost:8333/pme-public
# Google sign-in is enabled only when both are set (Google Cloud console, OAuth client
# "Web application", redirect URI {API_URL}/v1/auth/callback/google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Seconds readiness reports "draining" before the server stops accepting connections.
SHUTDOWN_GRACE_SECONDS=0
# Optional; Sentry is off when unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
